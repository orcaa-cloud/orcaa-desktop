{
  "name": "orcaa-desktop",
  "version": "1.4.6",
  "description": "Tauri 2.x desktop wrapper for the Orcaa PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:business": "tauri icon src-tauri/source-icons/business.png --output src-tauri/icons/business",
